# Required: deployment environment.
APP_ENV=development
# Required in production: release tag or commit SHA exposed by /version.
APP_VERSION=dev
# Required: URL for REMI's own database/user; the PostgreSQL server may be shared.
DATABASE_URL=postgresql://remi:change-me@postgres:5432/remi
# Required: new BotFather token. Never reuse an old token.
BOT_TOKEN=
# Required: numeric Telegram user ID of the sole owner.
OWNER_TELEGRAM_USER_ID=
# Required: private Telegram channel/supergroup used as REMI media storage.
STORAGE_CHAT_ID=
# Optional: JSON log threshold.
LOG_LEVEL=info
# Optional: HTTP health server port.
PORT=3000
# Optional: timezone used only when the owner profile is first created.
DEFAULT_TIMEZONE=Asia/Tehran
# Optional: scheduler interval in milliseconds.
SCHEDULER_POLL_MS=5000
# Optional: parallel delivery workers (1-8).
DELIVERY_CONCURRENCY=2
# Optional: maximum delivery attempts (1-100).
MAX_DELIVERY_ATTEMPTS=5
# Optional: maximum catch-up executions per rule (1-1000).
MAX_CATCH_UP_EXECUTIONS_PER_RULE=10
